# Transactional email delivery (Resend) for /api/contact -> zeid@orionyouth.eu
# If unset in local development, inquiries are validated and logged server-side instead of sent.
RESEND_API_KEY=

# Optional verified sender address for Resend (defaults to onboarding@resend.dev if omitted)
# Verify Resend on a sending subdomain (e.g., send.orionyouth.eu) so root Outlook MX records on orionyouth.eu are unaffected.
RESEND_FROM_EMAIL="Orion Website <noreply@send.orionyouth.eu>"

# Public canonical site URL used for metadataBase, sitemap.xml, robots.txt, and OpenGraph cards
NEXT_PUBLIC_SITE_URL="https://www.orionyouth.eu"
